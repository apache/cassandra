# Generates completions for the options and subcommands of the `stop` subcommand.
function _picocli_nodetool_stop() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts=""
  local arg_opts="'-id' '--compaction-id'"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    '-id'|'--compaction-id')
      return
      ;;
  esac
  local compaction_type_pos_param_args=("Cancel all operations" "Cleanup" "Scrub" "Upgrade sstables" "Verify" "Major compaction" "Relocate sstables to correct disk" "Remove deleted data" "Flush" "Write" "Anticompaction after repair" "Validation" "Secondary index build" "View build" "Compaction" "Tombstone Compaction" "Unknown compaction type" "Stream" "Key cache save" "Row cache save" "Counter cache save" "Index summary redistribution") # 0-0 values

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local currIndex
    currIndex=$(currentPositionalIndex "stop" "${arg_opts}" "${flag_opts}")
    if (( currIndex >= 0 && currIndex <= 0 )); then
      positionals=$( compReplyArray "${compaction_type_pos_param_args[@]}" )
    fi
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

