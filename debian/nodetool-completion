  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts="'--all-keyspaces' '--all-tables' '--all-roles' '--all-functions' '--all-mbeans'"
  local arg_opts="'--keyspace' '--table' '--role' '--functions-in-keyspace' '--function' '--mbean'"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    '--keyspace')
      return
      ;;
    '--table')
      return
      ;;
    '--role')
      return
      ;;
    '--functions-in-keyspace')
      return
      ;;
    '--function')
      return
      ;;
    '--mbean')
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

