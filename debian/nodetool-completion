# Generates completions for the options and subcommands of the `start` subcommand.
function _picocli_nodetool_profile_start() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts=""
  local arg_opts="'-e' '--event' '-o' '--output' '-d' '--duration' '-f' '--format'"
  local event_option_args=("cpu" "alloc" "lock" "wall" "nativemem" "cache_misses") # --event values
  local outputFormat_option_args=("flat" "traces" "collapsed" "flamegraph" "tree" "jfr") # --format values

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    '-e'|'--event')
      local IFS=$'\n'
      COMPREPLY=( $( compReplyArray "${event_option_args[@]}" ) )
      return $?
      ;;
    '-o'|'--output')
      return
      ;;
    '-d'|'--duration')
      return
      ;;
    '-f'|'--format')
      local IFS=$'\n'
      COMPREPLY=( $( compReplyArray "${outputFormat_option_args[@]}" ) )
      return $?
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

