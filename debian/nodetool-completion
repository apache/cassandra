# Generates completions for the options and subcommands of the `getguardrailsconfig` subcommand.
function _picocli_nodetool_getguardrailsconfig() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts="'--expand'"
  local arg_opts="'--category' '-c'"
  local guardrailCategory_option_args=("values" "thresholds" "flags" "others") # --category values

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    '--category'|'-c')
      local IFS=$'\n'
      COMPREPLY=( $( compReplyArray "${guardrailCategory_option_args[@]}" ) )
      return $?
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

