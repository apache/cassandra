        raise EnvironmentError(f"{command} must be installed and available in the PATH for this operation.")


def normalize_jenkins_url(value):
    """Keep scheme and context path, and exclude credentials from URLs and log messages."""
    parts = urlsplit(value if "://" in value else "http://" + value)
    if parts.scheme not in ("http", "https") or not parts.hostname:
        raise ValueError("Use a Jenkins HTTP(S) URL with a hostname.")
    if parts.username is not None or parts.password is not None or parts.query or parts.fragment:
        raise ValueError("Use a Jenkins URL without embedded credentials, query or fragment.")
    # Accessing port also validates malformed port numbers.
    port = parts.port
    if port == 0:
        raise ValueError("Jenkins URL port must be greater than zero.")
    host = f"[{parts.hostname}]" if ":" in parts.hostname else parts.hostname
    if port and (parts.scheme, port) not in (("http", 80), ("https", 443)):
        host += f":{port}"
    return urlunsplit((parts.scheme, host, parts.path.rstrip("/"), "", ""))


def default_credentials_file():
    directory = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    if not directory.is_absolute():
        directory = Path.home() / ".config"
    return directory / "cassandra" / "run-ci-credentials.json"


def read_credentials_file(path):
    """Read an owner-only regular file without following a final symlink."""
    path = Path(path).expanduser()
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return {}
    with os.fdopen(descriptor, encoding="utf-8") as handle:
        info = os.fstat(handle.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077):
            raise ValueError("Credentials must be an owned regular file with permissions 0600 and no links.")
        try:
            entries = json.load(handle)
        except (ValueError, UnicodeError) as error:
            raise ValueError("Invalid credentials file JSON.") from error
    if not isinstance(entries, dict) or any(
            not isinstance(url, str) or not isinstance(entry, dict)
            or not isinstance(entry.get("user"), str) or not entry["user"]
            or not isinstance(entry.get("token"), str) or not entry["token"]
            for url, entry in entries.items()):
        raise ValueError("Invalid credentials file entries; expected URL, user and token.")
    return entries


def load_credentials(path, url):
    return read_credentials_file(path).get(normalize_jenkins_url(url))


def save_credentials(path, url, user, token):
    """Replace the file atomically; temporary and final files are accessible only to their owner."""
    path = Path(path).expanduser()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    parent = path.parent.lstat()
    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.getuid() or parent.st_mode & 0o022:
        raise ValueError("Credentials directory must be owned by you and not writable by other users.")
    entries = read_credentials_file(path)
    entries[normalize_jenkins_url(url)] = {"user": user, "token": token}
    descriptor, temporary = tempfile.mkstemp(prefix=".run-ci-credentials-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            os.fchmod(handle.fileno(), 0o600)
            json.dump(entries, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def parse_attach(args, parser):
    if not args.attach:
        return
    if any((args.setup, args.only_setup, args.tear_down, args.only_tear_down,
            args.only_node_cleaner, args.download_results)):
        parser.error("--attach cannot be combined with setup, teardown, node cleaner or --download-results.")
    if args.attach.isdecimal():
        if int(args.attach) < 1:
            parser.error("--attach requires a positive build number.")
        args.attach = int(args.attach)
        return
    url = urlsplit(normalize_jenkins_url(args.attach))
    match = re.fullmatch(r"(.*?)((?:/job/[^/]+)+)/([1-9][0-9]*)", url.path)
    if not match:
        parser.error("--attach needs a build URL ending in /job/JOB/NUMBER/ or a positive build number.")
    base = urlunsplit((url.scheme, url.netloc, match[1], "", ""))
    job = "/".join(unquote(name) for name in match[2].split("/job/")[1:])
    if args.url and normalize_jenkins_url(args.url) != base:
        parser.error("--url and --attach name different Jenkins servers.")
    if args.job and args.job != job:
        parser.error("--job and --attach name different jobs.")
    args.url, args.job, args.attach = base, job, int(match[3])


