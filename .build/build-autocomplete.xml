<project name="autocomplete">
    <property name="autocomplete.dir" location="${build.dir}/autocomplete"/>
    <property name="autocomplete.tmp.dir" location="${tmp.dir}/autocomplete"/>

    <target name="check-gen-autocomplete" depends="build">
        <uptodate property="autocomplete.current" targetfile="${autocomplete.dir}/nodetool">
            <srcfiles dir="${build.classes.main}" includes="org/apache/cassandra/tools/**/*.class"/>
            <srcfiles dir="${build.dir.lib}" includes="**/picocli-*.jar"/>
            <srcfiles dir="${build.helpers.dir}" includes="build-autocomplete.xml,header.txt"/>
        </uptodate>
    </target>

    <target name="gen-autocomplete" depends="check-gen-autocomplete" unless="autocomplete.current"
            description="Generate shell autocomplete script">
        <mkdir dir="${autocomplete.tmp.dir}"/>
        <java classname="picocli.AutoComplete" fork="true" failonerror="true" classpathref="cassandra.classpath">
            <sysproperty key="picocli.autocomplete.systemExitOnError" value="true"/>
            <arg value="-f"/>
            <arg value="-n"/>
            <arg value="nodetool"/>
            <arg value="-o"/>
            <arg value="${autocomplete.tmp.dir}/nodetool.tmp"/>
            <arg value="org.apache.cassandra.tools.nodetool.NodetoolCommand"/>
        </java>
        <replaceregexp file="${autocomplete.tmp.dir}/nodetool.tmp"
                       match="^#!/usr/bin/env bash\r?\n" replace="" byline="false"/>
        <echo file="${autocomplete.tmp.dir}/nodetool" message="#!/usr/bin/env bash&#10;"/>
        <concat destfile="${autocomplete.tmp.dir}/nodetool" append="true">
            <file file="${build.helpers.dir}/header.txt"/>
            <file file="${autocomplete.tmp.dir}/nodetool.tmp"/>
        </concat>
        <move file="${autocomplete.tmp.dir}/nodetool" tofile="${autocomplete.dir}/nodetool"/>
        <delete dir="${autocomplete.tmp.dir}"/>
        <echo message="Nodetool autocomplete script generated at ${autocomplete.dir}/nodetool"/>
        <echo message="Source this file in Bash or Zsh to enable nodetool autocomplete."/>
    </target>
</project>
